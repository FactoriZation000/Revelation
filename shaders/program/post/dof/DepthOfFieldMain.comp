vec2 ApplyCatEyeEffect(vec2 sampleUV, vec2 screenCenter, vec2 baseOffset)
{
    // We assume that the center of the screen is the optical axis.
    vec2 centerToPixel = sampleUV - screenCenter;

    float normalizedRadius = length(centerToPixel) / length(vec2(0.5f));

    vec2 radialDir = centerToPixel / max(length(centerToPixel), 1e-6);
    vec2 tangentDir  = vec2(-radialDir.y, radialDir.x);// radialDir * mat2(cos(0.5 * PI), -sin(0.5 * PI), sin(0.5 * PI), cos(0.5 * PI));

    // The farther away from the optical axis, the larger the distortion factor.
    float distanceFactor = smoothstep(0.20f, 0.80f, clamp(normalizedRadius, 0.0f, 1.0f));

    float radialScale   = mix(1.0f, DOF_CAT_EYE_EFFECT_RADIAL_STRENGTH, distanceFactor);
    float tangentScale  = mix(1.0f, DOF_CAT_EYE_EFFECT_TANGENT_STRENGTH, distanceFactor);

    // Apply the radial distortion and the tangent distortion.
    vec2 shapedOffset = radialDir * radialScale * baseOffset.x
                      + tangentDir * tangentScale * baseOffset.y;

    float radialDisplacement = mix(0.0f, 0.6f, distanceFactor);
    // // Check whether distorted sampling points is legal(in the unit circle).
    // float mask = clamp(1.0f - max(0.0f, length(shapedOffset + radialDisplacement * radialDir) - 1.0f) * 6.0f, 0.0f, 1.0f);

    return shapedOffset;
}

//======// Main //================================================================================//


void main()
{
    global.prevCenterDepth = global.centerDepthSmooth;

	vec3 color = vec3(0.0f);

    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = texelToUv(texel);

    float centerCOC = imageLoad(CocImage, texel).x;
    vec3 centerColor = imageLoad(prefilterImage, texel).rgb;

    // float originalCOC = imageLoad(tileDataImage, texel / 4).w;

    vec2 screenCoord = gl_GlobalInvocationID.xy * 2.0f * viewPixelSize;
	vec2 clipCoord = screenCoord * 2.0f - 1.0f;
    vec2 colorAberrationOffset = sqr(clipCoord) * clamp(centerCOC * DOF_COLOR_ABERRATION_FACTOR, -DOF_COLOR_ABERRATION_MAX_OFFSET, DOF_COLOR_ABERRATION_MAX_OFFSET);

    color = vec3(0.0f);

    uint ringCount = uint(clamp(ceil(sqrt(centerCOC) * DOF_RING_COUNT), 1, DOF_RING_COUNT));// Use sqrt() to make sure increasing evenly
    const uint ringSampleCount[] = {1u, 9u, 25u, 49u}; // 4n(n-1)+1
    vec2 ringScale = float(ringCount) / float(DOF_RING_COUNT) * centerCOC * viewPixelSize * 0.5f;

    float totalWeight = 1.0f;// Do not forget the center point
    // Sample from outside to inside.Reference:[1]
    for (uint j = ringCount; j > 0; --j)
    {
        uint startIdx = ringSampleCount[j - 1];
        uint endIdx = ringSampleCount[j];
        float ringRadius = float(j) / float(ringCount);

        // Rotate the sample points per ring to reduce artifacts
        float noise = BlueNoiseTemporal(texel) * TAU * rcp(ringSampleCount[j]);
        vec2 cossin = cossin(noise);
        mat2 rot = mat2(cossin.x, -cossin.y, cossin.y, cossin.x);

        for (uint i = startIdx; i < endIdx; ++i)
        {
            vec2 offset = circularBokehOffsets[i] * ringRadius * rot;
            #ifdef DOF_CAT_EYE_EFFECT
                offset = ApplyCatEyeEffect(clipCoord, vec2(0.5f), offset);
            #endif
            vec2 sampleUV = uv + ringScale * offset;

            float sampleCOC = imageLoad(CocImage, uvToTexel(sampleUV)).x;
            float depthDiff = abs(centerCOC - sampleCOC);
            float edgeWeight = exp(-depthDiff);
            // color += texelFetch(prefilter, uvToTexel(sampleUV), 0).rgb;
            #ifdef DOF_COLOR_ABERRATION
                color.r += textureLod(prefilter, sampleUV + colorAberrationOffset, 0.0f).r * edgeWeight;
        	    color.g += textureLod(prefilter, sampleUV, 0.0f).g * edgeWeight;
        	    color.b += textureLod(prefilter, sampleUV - colorAberrationOffset, 0.0f).b * edgeWeight;
            #else
                // color += texelFetch(prefilter, uvToTexel(sampleUV), 0).rgb;
                color += textureLod(prefilter, sampleUV, 0.0f).rgb * edgeWeight;
            #endif

            // It seems that bilinear sampling can get a better result compared to the point sampling which was mentioned in COD's PPT.
            totalWeight += edgeWeight;
        }
    }

    #ifdef DOF_COLOR_ABERRATION
        color.r += textureLod(prefilter, uv + colorAberrationOffset, 0.0f).r;
        color.g += textureLod(prefilter, uv , 0.0f).g;
        color.b += textureLod(prefilter, uv - colorAberrationOffset, 0.0f).b;
    #else
        color += textureLod(prefilter, uv, 0.0f).rgb;// center
    #endif

    color *= SafeRcp(totalWeight);

    imageStore(mainDataImage, texel, vec4(color, 0.0f));
}
