#define DOF_TILE_SIZE 8
layout (local_size_x = 16, local_size_y = 16) in;

//======// Image //===============================================================================//


// Input: prefiltered scene RGB
layout (r11f_g11f_b10f) restrict uniform image2D prefilterImage;
// Input: R:neighborhoodMinDepth G:neighborhoodMaxCOC B:neighborhoodMinCOC
layout (r11f_g11f_b10f) restrict uniform image2D tileDataNeighborhoodImage;
// Input: R:minDepth G:maxCOC B:minCOC A:originalCOC
layout (rgba16f) restrict uniform image2D tileDataImage;
// Input: COC
layout (r16f) restrict uniform readonly image2D CocImage;

// Output: RGB:color
layout (r11f_g11f_b10f) restrict uniform image2D mainDataImage;

