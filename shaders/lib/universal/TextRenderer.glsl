vec3 outputNAN(ivec2 pos, int size, vec3 color) {
	vec3 result = vec3(0.0);
    ivec2 screenTexel = ivec2(gl_FragCoord.s,gl_FragCoord.t - size);

    if (max(screenTexel, ivec2(pos.x, pos.y - size * 6)) == screenTexel) {
        int lastText = NAN_advances[NAN_encodings.length() - 1];
        if (min(screenTexel, ivec2(pos.x + size * (lastText + 6), pos.y + size * 11)) == screenTexel) {
            int relPos = screenTexel.x - pos.x;
            relPos /= size;

            // Binary search for the character index
            int left = 0, right = NAN_advances.length();
            while (left < right) {
                int middle = (left + right) >> 1;
                if (relPos >= NAN_advances[middle]) left = middle + 1;
                else right = middle;
            }

            int index = left - 1;
            pos += ivec2(size * NAN_advances[index], 0);
            result = uint(isText(screenTexel, pos, NAN_encodings[index], size)) * color;
        }
    }

	return result;
}

// uint
vec3 outputNumber(uint num, ivec2 pos, int size, vec3 color){

    vec3 numColor = vec3(0.0);
    // special value
    if (isnan(num)) {
        return outputNAN(pos,size,vec3(1,0,0));
    }
    else if (isinf(num)) {
        return outputINF(pos,size,vec3(1,0,0));
    }

    ivec2 texel = ivec2(gl_FragCoord.st);
    ivec2 posOffset = ivec2(0, size);

    // Calculate the number of significant digits.
    uint numDigits = 1;
    uint tempNum = num;
    uint divisor = 1;

    while (tempNum / divisor >= 10) {
        divisor *= 10;
        numDigits++;
    }

    // If there isn't any significant digit,return 1 to display a "0"
    if (numDigits == 0) { numDigits = 1; }

    // Render the significant digit
    for (uint i = 0; i < numDigits; i++) {
        uint digit = (num / divisor) % 10;
        ivec2 digitPos = pos + posOffset + ivec2(i * size * 6, 0);

        if (max(texel, digitPos) == texel) {
            if (min(texel, digitPos + ivec2(size * 6, size * 11)) == texel) {
                numColor += color * uint(isText(texel, digitPos, number[digit], size));
            }
        }
        divisor /= 10;
    }

    return numColor;

}

bool isNegative(int num){
    if (num < 0) { return true; } else { return false; }
}

bool isNegative(float num){
    if (num < 0) { return true; } else { return false; }
}


float log10(float x) {
    return log2(x) / log2(10.0);
}

// int
vec3 outputNumber(int num, ivec2 pos, int size, vec3 color){

    vec3 numColor = vec3(0.0);
    // special value
    if (isnan(num)) {
        return outputNAN(pos,size,vec3(1,0,0));
    }
    else if (isinf(num)) {
        return outputINF(pos,size,vec3(1,0,0));
    }

    ivec2 texel = ivec2(gl_FragCoord.st);
    ivec2 posOffset = ivec2(0, size);

    // Calculate the number of significant digits.
    int numDigits = 1;
    int tempNum = abs(num);
    int divisor = 1;

    while (tempNum / divisor >= 10) {
        divisor *= 10;
        numDigits++;
    }

    // If there isn't any significant digit,return 1 to display a "0"
    if (numDigits == 0) { numDigits = 1; }

    // Render the significant digit
    for (int i = 0; i < numDigits; i++) {
        int digit = (abs(num) / divisor) % 10;
        ivec2 digitPos = pos + posOffset + ivec2(i * size * 6, 0);

        if (max(texel, digitPos) == texel) {
            if (min(texel, digitPos + ivec2(size * 6, size * 11)) == texel) {
                numColor += color * uint(isText(texel, digitPos, number[digit], size));
            }
        }
        divisor /= 10;
    }

    // Render negative sign
    ivec2 signPos = ivec2(pos.x - size * 6, pos.y + size * 2);
    if (max(texel, signPos) == texel) {
        if (min(texel, signPos + ivec2(size * 6, size * 11)) == texel) {
            numColor += color * uint(isText(texel, signPos, CHAR_MINUS, size)) * uint(isNegative(num));
        }
    }

    return numColor;

}

// Use less "while" to avoid TDR!
// float(The core of other types)
vec3 outputNumber(float num, ivec2 pos, int size, vec3 color) {
    vec3 numColor = vec3(0.0);

    // Special values
    if (isnan(num)) {
        return outputNAN(pos, size, vec3(1, 0, 0));
    } else if (isinf(num)) {
        return outputINF(pos, size, vec3(1, 0, 0));
    }

    ivec2 texel = ivec2(gl_FragCoord.st);
    ivec2 posOffset = ivec2(0, size);

    // Convert the number to scientific notation
    int exponent = 0;
    float normalizedNum = abs(num);

    // Normalize the number to be between 1 and 10
    if (normalizedNum > 0.0) {
        exponent = int(floor(log10(normalizedNum)));
        normalizedNum /= pow(10.0, float(exponent));
    } else {
        normalizedNum = 0.0;
    }

    // Round the normalized number to control precision
    normalizedNum = round(normalizedNum * 1e5) / 1e5; // Round to 5 decimal places

    // Render the mantissa (integer part and fractional part)
    int integerPart = int(normalizedNum);
    float fractionalPart = fract(normalizedNum);

    // Render the integer part
    int numDigits = 1;
    int tempNum = integerPart;
    int divisor = 1;

    while (tempNum / divisor >= 10) {
        divisor *= 10;
        numDigits++;
    }

    for (int i = 0; i < numDigits; i++) {
        int digit = (integerPart / divisor) % 10;
        ivec2 digitPos = pos + posOffset + ivec2(i * size * 6, 0);

        if (max(texel, digitPos) == texel) {
            if (min(texel, digitPos + ivec2(size * 6, size * 11)) == texel) {
                numColor += color * uint(isText(texel, digitPos, number[digit], size));
            }
        }
        divisor /= 10;
    }

    // Render the decimal point
    ivec2 decimalPos = pos + posOffset + ivec2(numDigits * size * 6, 0);
    if (max(texel, decimalPos) == texel) {
        if (min(texel, decimalPos + ivec2(size * 6, size * 11)) == texel) {
            numColor += color * uint(isText(texel, decimalPos, signOfNumber[0], size));
        }
    }

    // Render the fractional part (up to 5 digits)
    for (int i = 0; i < 5; i++) {
        fractionalPart *= 10.0;
        int digit = int(fractionalPart);
        fractionalPart -= float(digit);

        ivec2 digitPos = pos + posOffset + ivec2(size * ((numDigits + 1 + i) * 6 - 4), 0);

        if (max(texel, digitPos) == texel) {
            if (min(texel, digitPos + ivec2(size * 6, size * 11)) == texel) {
                numColor += color * uint(isText(texel, digitPos, number[digit], size));
            }
        }
    }

    // Render the 'e' for scientific notation
    ivec2 ePos = pos + posOffset + ivec2(size * ((numDigits + 6) *  6 - 4), 0);
    if (max(texel, ePos) == texel) {
        if (min(texel, ePos + ivec2(size * 6, size * 11)) == texel) {
            numColor += color * uint(isText(texel, ePos, signOfNumber[1], size));
        }
    }

    // Render the exponent
    int exponentDigits = 1;
    int tempExponent = abs(exponent);
    divisor = 1;

    while (tempExponent / divisor >= 10) {
        divisor *= 10;
        exponentDigits++;
    }

    int exponentRenderOffset = 0;

    // Render the negative sign for the exponent if necessary
    if (exponent < 0) {
        ivec2 signPos = pos + posOffset + ivec2(size * ((numDigits + 7) * 6 - 4), size);
        if (max(texel, signPos) == texel) {
            if (min(texel, signPos + ivec2(size * 6, size * 11)) == texel) {
                numColor += color * uint(isText(texel, signPos, signOfNumber[2], size));
            }
        }
        exponentRenderOffset += 1;
    }

    // Render the exponent
    for (int i = 0; i < exponentDigits; i++) {
        int digit = (abs(exponent) / divisor) % 10;

        ivec2 digitPos = pos + posOffset + ivec2(size * ((numDigits + 7 + i + exponentRenderOffset) * 6 - 4), 0);

        if (max(texel, digitPos) == texel) {
            if (min(texel, digitPos + ivec2(size * 6, size * 11)) == texel) {
                numColor += color * uint(isText(texel, digitPos, number[digit], size));
            }
        }
        divisor /= 10;
    }

    // Render negative sign
    ivec2 signPos = ivec2(pos.x - size * 6, pos.y + size * 2);
    if (max(texel, signPos) == texel) {
        if (min(texel, signPos + ivec2(size * 6, size * 11)) == texel) {
            numColor += color * uint(isText(texel, signPos, signOfNumber[2], size)) * uint(isNegative(num));
        }
    }

    return numColor;
}

//=================================// Function Graph Plotting //=================================//

// https://www.shadertoy.com/view/WslGzl
// Shader License: CC BY 3.0
// Author: Jan Mróz (jaszunio15)

// View setting
#define SCALE_X 8.0
#define SCALE_Y 4.5
#define CENTER_POINT vec2(0.0, 0.0)
#define THICKNESS 0.004

#define EPSILON 0.001
#define pow4(x) (x * x * x * x)

// Grid setting
#define GRID_THICKNESS 0.004
#define GRID1_DENSITY 1.0
#define GRID2_DENSITY 0.5
#define GRID_INTENSITY 0.2

// Define your function here:
float functionY(float x) { return ceil(sqrt(x) * 3); }

#define INITIALIZE_FUNCTION(f, color) funcData(f(uv.x), color , (f(uv.x + EPSILON) - f(uv.x - EPSILON)) / (2.0 * EPSILON), true)

struct funcData
{
 	float value;
    vec3 color;
    float derivative;
    bool inDomain;
};

// For grid calc
vec2 triangleFunc(vec2 x) { return (abs(fract(x) - 0.5)) * 2.0; }

void plotFunctionGraph(vec2 windowSize, inout vec3 color) {
    // uv = coordinate system
    vec2 uv = gl_FragCoord.xy * 2.0 / windowSize.xy;
    uv -= 1.0;
    uv *= vec2(SCALE_X, SCALE_Y);
    uv += CENTER_POINT;

    vec3 mainColor = vec3(0.0);

    // function and grid thickness
    float aspect = (windowSize.y / windowSize.x) / (SCALE_Y / SCALE_X);
    float hdScale = 1080.0 / windowSize.y;
    float thickness = THICKNESS * hdScale * min(SCALE_X, SCALE_Y);
    float gridThickness = GRID_THICKNESS * hdScale * min(SCALE_X, SCALE_Y);

    funcData func= INITIALIZE_FUNCTION(functionY, vec3(0.0, 1.0, 1.0));

    // vertical distance to function and dericative
    float distanceToFunction = abs(uv.y - func.value);
    float tgAlpha = clamp(abs(func.derivative * aspect), 0.0, 16.0); //clamp to avoid vertical lines (e.g. saw or square function)

    // vertical thickness from normal thickness and derivative
    float verticalThickness = sqrt(tgAlpha * tgAlpha + 3.0);
    float intensity = 1.0 - smoothstep(0.0, thickness, distanceToFunction / verticalThickness);
    if (func.inDomain) mainColor += func.color * pow4(intensity);

    //Adding grid
    vec2 grid;

    //OY and OX axis
    grid = smoothstep(vec2(1.0) - vec2(gridThickness * aspect, gridThickness), vec2(1.0), 1.0 - abs(uv));
    mainColor += vec3(max(grid.x, grid.y)) * GRID_INTENSITY * 0.5;

    //GRID1
    grid = smoothstep(vec2(1.0) - vec2(gridThickness * aspect, gridThickness) / GRID1_DENSITY, vec2(1.0), triangleFunc(uv / GRID1_DENSITY));
    mainColor += vec3(max(grid.x, grid.y)) * GRID_INTENSITY;
    //GRID2
    grid = smoothstep(vec2(1.0) - vec2(gridThickness * aspect, gridThickness) / GRID2_DENSITY, vec2(1.0), triangleFunc(uv / GRID2_DENSITY));
    mainColor += vec3(max(grid.x, grid.y)) * GRID_INTENSITY * 0.5;

    color = mainColor;

}

