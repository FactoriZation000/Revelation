vec3 outputINF(ivec2 pos, int size, vec3 color) {
	vec3 result = vec3(0.0);
    ivec2 screenTexel = ivec2(gl_FragCoord.s, gl_FragCoord.t - size);

    if (max(screenTexel, ivec2(pos.x, pos.y - size * 6)) == screenTexel) {
        int lastText = INF_advances[INF_encodings.length() - 1];
        if (min(screenTexel, ivec2(pos.x + size * (lastText + 6), pos.y + size * 11)) == screenTexel) {
            int relPos = screenTexel.x - pos.x;
            relPos /= size;

            // Binary search for the character index
            int left = 0, right = INF_advances.length();
            while (left < right) {
                int middle = (left + right) >> 1;
                if (relPos >= INF_advances[middle]) left = middle + 1;
                else right = middle;
            }

            int index = left - 1;
            pos += ivec2(size * INF_advances[index], 0);
            result = uint(isText(screenTexel, pos, INF_encodings[index], size)) * color;
        }
    }

	return result;
}


