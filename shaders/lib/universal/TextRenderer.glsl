void outputBufferData(inout vec3 inputOutputCol, sampler2D tex)
{
    inputOutputCol = texelFetch(tex,ivec2(gl_FragCoord.xy), 0).rgb;
}

void outputBufferData(inout vec3 inputOutputCol, vec2 screenCoord, sampler2D tex0, sampler2D tex1, sampler2D tex2, sampler2D tex3)
{

    if (screenCoord.x < 0.5 && screenCoord.y > 0.5) {
        inputOutputCol = texture(tex0,vec2(screenCoord.x, screenCoord.y - 0.5) * 2.0).rgb;
    } else if (screenCoord.x > 0.5 && screenCoord.y > 0.5) {
        inputOutputCol = texture(tex1,vec2(screenCoord.x - 0.5, screenCoord.y - 0.5) * 2.0).rgb;
    } else if (screenCoord.x < 0.5 && screenCoord.y < 0.5) {
        inputOutputCol = texture(tex2,vec2(screenCoord.x, screenCoord.y) * 2.0).rgb;
    } else {
        inputOutputCol = texture(tex3,vec2(screenCoord.x - 0.5, screenCoord.y) * 2.0).rgb;
    }

}

