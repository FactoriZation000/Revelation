vec3 renderBackground(ivec2 startPos, ivec2 endPos,vec3 color) {
    ivec2 texel = ivec2(gl_FragCoord.st);
    if (texel == clamp(texel, startPos, endPos)) {
        return color;
    }
    return vec3(0.0);
}

void renderBackground(in ivec2 startPos, in ivec2 endPos, inout vec3 originalColor, in vec3 color) {
    ivec2 texel = ivec2(gl_FragCoord.st);
    if (texel == clamp(texel, startPos, endPos)) {
        originalColor = color;
    }
}
