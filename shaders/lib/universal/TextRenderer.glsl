    matColor += outputNumber(mat[1][2], ivec2(pos.x + 158.33 * size,pos.y + 4.16 * size), size, color);

    matColor += outputNumber(mat[2][0], ivec2(pos.x + 8.33   * size,pos.y - 6.66 * size), size, color);
    matColor += outputNumber(mat[2][1], ivec2(pos.x + 83.33  * size,pos.y - 6.66 * size), size, color);
