//pos and size should be the same as the text
vec3 renderBackground_0(ivec2 pos, int size, vec3 color) {
    ivec2 texel = ivec2(gl_FragCoord.st);

    ivec2 start = pos - size;
    // Calculate the offset
    uint offsetX = text_advances_0[text_advances_0.length() - 1] * size + (size << 3);
    uint offsetY = size << 3 ;
    ivec2 end = pos + ivec2(offsetX, offsetY);

    if (texel == clamp(texel, start, end)) {
        return color;
    }
    return vec3(0.0);
}

