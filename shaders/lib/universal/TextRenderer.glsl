// Original Text: True
const uvec3 TRUE_encodings[] = {CHAR_T,CHAR_r,CHAR_u,CHAR_e,};
const int TRUE_advances[] = {0,6,12,18,};

vec3 outputTrue(ivec2 pos, int size, vec3 color) {
	vec3 result = vec3(0.0);
    ivec2 screenTexel = ivec2(gl_FragCoord.s, gl_FragCoord.t - size);

    if (max(screenTexel, ivec2(pos.x, pos.y - size * 6)) == screenTexel) {
        int lastText = TRUE_advances[TRUE_encodings.length() - 1];
        if (min(screenTexel, ivec2(pos.x + size * (lastText + 6), pos.y + size * 11)) == screenTexel) {
            int relPos = screenTexel.x - pos.x;
            relPos /= size;

            // Binary search for the character index
            int left = 0, right = TRUE_advances.length();
            while (left < right) {
                int middle = (left + right) >> 1;
                if (relPos >= TRUE_advances[middle]) left = middle + 1;
                else right = middle;
            }

            int index = left - 1;
            pos += ivec2(size * TRUE_advances[index], 0);
            result = uint(isText(screenTexel, pos, TRUE_encodings[index], size)) * color;
        }
    }

	return result;
}

// Original Text: False
const uvec3 FALSE_encodings[] = {CHAR_F,CHAR_a,CHAR_l,CHAR_s,CHAR_e,};
const int FALSE_advances[] = {0,6,12,15,21,};

vec3 outputFalse(ivec2 pos, int size, vec3 color) {
	vec3 result = vec3(0.0);
    ivec2 screenTexel = ivec2(gl_FragCoord.s,gl_FragCoord.t - size);

    if (max(screenTexel, ivec2(pos.x, pos.y - size * 6)) == screenTexel) {
        int lastText = FALSE_advances[FALSE_encodings.length() - 1];
        if (min(screenTexel, ivec2(pos.x + size * (lastText + 6), pos.y + size * 11)) == screenTexel) {
            int relPos = screenTexel.x - pos.x;
            relPos /= size;

            // Binary search for the character index
            int left = 0, right = FALSE_advances.length();
            while (left < right) {
                int middle = (left + right) >> 1;
                if (relPos >= FALSE_advances[middle]) left = middle + 1;
                else right = middle;
            }

            int index = left - 1;
            pos += ivec2(size * FALSE_advances[index], 0);
            result = uint(isText(screenTexel, pos, FALSE_encodings[index], size)) * color;
        }
    }

	return result;
}

vec3 outputBool(bool b, ivec2 pos, int size, vec3 color) {

    vec3 result = vec3(0.0);

    if (b) {
        result = outputTrue(pos, size, color);
    } else {
        result = outputFalse(pos, size, color);
    }

    return result;
}

void outputColor(inout vec3 inputOutputCol, vec3 outputCol, ivec2 pos, int size) {

    ivec2 screenTexel = ivec2(gl_FragCoord.s, gl_FragCoord.t - size);
        if (max(screenTexel, ivec2(pos.x, pos.y - size * 6)) == screenTexel) {
            if (min(screenTexel, ivec2(pos.x + size *  6, pos.y)) == screenTexel) {
               inputOutputCol = outputCol;
        }
    }

}

