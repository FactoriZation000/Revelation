vec3 debugCharacters(ivec2 pos, int size){
    vec3 result = vec3(0.0);

    ivec2 texel = ivec2(gl_FragCoord.st);
    ivec2 posOffset = ivec2(0, size);

    for (uint i = 0; i < charactersDebug.length(); i++) {
        uint line =(i / 12) % 10;
        ivec2 characterPos = pos + posOffset + ivec2(size * (i * 7 - line * 84), - line * 10 * size);

        if (max(texel, characterPos - ivec2(0, size)) == texel) {
            if (min(texel, characterPos + ivec2(size * 7, size * 11)) == texel) {
                result += vec3(1.0) * uint(isText(texel, characterPos, charactersDebug[i], size));
            }
        }
    }

    return result;
}

//=================================// Text Render //==========================================//

vec3 renderChar(ivec2 pos, int size, vec3 color, uvec3 character) {
	vec3 result = vec3(0.0);
    ivec2 screenTexel = ivec2(gl_FragCoord.st);

    if (max(screenTexel, ivec2(pos.x, pos.y - size * 6)) == screenTexel) {
        if (min(screenTexel, ivec2(pos.x + size * 6, pos.y + size * 10)) == screenTexel) {
               result = uint(isText(screenTexel, ivec2(pos.x, pos.y + size), character, size)) * color;
        }
    }

	return result;
}

vec3 renderText_0(ivec2 pos, int size, vec3 color) {
	vec3 result = vec3(0.0);
    ivec2 screenTexel = ivec2(gl_FragCoord.st);

    if (max(screenTexel, ivec2(pos.x, pos.y - size * 6)) == screenTexel) {
        int lastText = text_advances_0[text_encodings_0.length() - 1];
        if (min(screenTexel, ivec2(pos.x + size * (lastText + 6), pos.y + size * 11)) == screenTexel) {
            int relPos = screenTexel.x - pos.x;
            relPos /= size;

            // Binary search for the character index
            int left = 0, right = text_advances_0.length();
            while (left < right) {
                int middle = (left + right) >> 1;
                if (relPos >= text_advances_0[middle]) left = middle + 1;
                else right = middle;
            }

            int index = left - 1;
            pos += ivec2(size * text_advances_0[index], 0);
            result = uint(isText(screenTexel, pos, text_encodings_0[index], size)) * color;
        }
    }



	return result;
}

